<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Case_lodgement" targetNamespace="urn:arch-diagram:Case_lodgement" exporter="arch-diagram" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Case_lodgement">
    <bpmn:participant id="P-CUST" name="Customer" processRef="Process_P-CUST"/>
    <bpmn:participant id="P-SVC" name="Service centre" processRef="Process_P-SVC"/>
    <bpmn:messageFlow id="R-P-CUST-messageFlow-E-START-lodgement" name="lodgement" sourceRef="P-CUST" targetRef="E-START"/>
    <bpmn:messageFlow id="R-T-REQ-messageFlow-P-CUST-information_request" name="information request" sourceRef="T-REQ" targetRef="P-CUST"/>
    <bpmn:messageFlow id="R-T-NOTIFY-messageFlow-P-CUST-outcome" name="outcome" sourceRef="T-NOTIFY" targetRef="P-CUST"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P-CUST" name="Customer" isExecutable="false">
  </bpmn:process>
  <bpmn:process id="Process_P-SVC" name="Service centre" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P-SVC">
      <bpmn:lane id="L-AGENT" name="Service agent">
        <bpmn:flowNodeRef>T-REQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-HOLD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-ASSESS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B-SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-ESC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-ESC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L-SYS" name="Case system">
        <bpmn:flowNodeRef>E-START</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-REG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G-TRIAGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T-NOTIFY</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E-END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E-START" name="Case lodged">
      <bpmn:outgoing>R-E-START-sequenceFlow-T-REG</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E-START_ed"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T-REG" name="Register case">
      <bpmn:incoming>R-E-START-sequenceFlow-T-REG</bpmn:incoming>
      <bpmn:outgoing>R-T-REG-sequenceFlow-G-TRIAGE</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="R-T-REG-dataOutput-D-CASE">
        <bpmn:targetRef>D-CASE</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G-TRIAGE" name="Lodgement complete?" default="R-G-TRIAGE-sequenceFlow-T-REQ-no">
      <bpmn:incoming>R-T-REG-sequenceFlow-G-TRIAGE</bpmn:incoming>
      <bpmn:outgoing>R-G-TRIAGE-sequenceFlow-T-ASSESS-yes</bpmn:outgoing>
      <bpmn:outgoing>R-G-TRIAGE-sequenceFlow-T-REQ-no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T-REQ" name="Request missing information">
      <bpmn:incoming>R-G-TRIAGE-sequenceFlow-T-REQ-no</bpmn:incoming>
      <bpmn:outgoing>R-T-REQ-sequenceFlow-E-HOLD</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E-HOLD" name="Awaiting information">
      <bpmn:incoming>R-T-REQ-sequenceFlow-E-HOLD</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T-ASSESS" name="Assess case">
      <bpmn:incoming>R-G-TRIAGE-sequenceFlow-T-ASSESS-yes</bpmn:incoming>
      <bpmn:outgoing>R-T-ASSESS-sequenceFlow-T-NOTIFY</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B-SLA" name="5 days" attachedToRef="T-ASSESS" cancelActivity="false">
      <bpmn:outgoing>R-B-SLA-sequenceFlow-T-ESC</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B-SLA_ed"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="T-ESC" name="Escalate to team lead">
      <bpmn:incoming>R-B-SLA-sequenceFlow-T-ESC</bpmn:incoming>
      <bpmn:outgoing>R-T-ESC-sequenceFlow-E-ESC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E-ESC" name="Escalated">
      <bpmn:incoming>R-T-ESC-sequenceFlow-E-ESC</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T-NOTIFY" name="Notify outcome">
      <bpmn:incoming>R-T-ASSESS-sequenceFlow-T-NOTIFY</bpmn:incoming>
      <bpmn:outgoing>R-T-NOTIFY-sequenceFlow-E-END</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E-END" name="Case closed">
      <bpmn:incoming>R-T-NOTIFY-sequenceFlow-E-END</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DataObject_D-CASE"/>
    <bpmn:dataObjectReference id="D-CASE" name="Case record" dataObjectRef="DataObject_D-CASE"/>
    <bpmn:sequenceFlow id="R-E-START-sequenceFlow-T-REG" sourceRef="E-START" targetRef="T-REG"/>
    <bpmn:sequenceFlow id="R-T-REG-sequenceFlow-G-TRIAGE" sourceRef="T-REG" targetRef="G-TRIAGE"/>
    <bpmn:sequenceFlow id="R-G-TRIAGE-sequenceFlow-T-ASSESS-yes" name="yes" sourceRef="G-TRIAGE" targetRef="T-ASSESS"/>
    <bpmn:sequenceFlow id="R-G-TRIAGE-sequenceFlow-T-REQ-no" name="no" sourceRef="G-TRIAGE" targetRef="T-REQ"/>
    <bpmn:sequenceFlow id="R-T-REQ-sequenceFlow-E-HOLD" sourceRef="T-REQ" targetRef="E-HOLD"/>
    <bpmn:sequenceFlow id="R-T-ASSESS-sequenceFlow-T-NOTIFY" sourceRef="T-ASSESS" targetRef="T-NOTIFY"/>
    <bpmn:sequenceFlow id="R-B-SLA-sequenceFlow-T-ESC" sourceRef="B-SLA" targetRef="T-ESC"/>
    <bpmn:sequenceFlow id="R-T-ESC-sequenceFlow-E-ESC" sourceRef="T-ESC" targetRef="E-ESC"/>
    <bpmn:sequenceFlow id="R-T-NOTIFY-sequenceFlow-E-END" sourceRef="T-NOTIFY" targetRef="E-END"/>
    <bpmn:textAnnotation id="A-TRIAGE"><bpmn:text>Complete = identity verified and evidence attached</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="R-A-TRIAGE-association-G-TRIAGE" sourceRef="A-TRIAGE" targetRef="G-TRIAGE"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_lodgement" name="Case lodgement: collaboration">
    <bpmndi:BPMNPlane id="Plane_lodgement" bpmnElement="Collaboration_Case_lodgement">
      <bpmndi:BPMNShape id="P-CUST_di" bpmnElement="P-CUST" isHorizontal="true">
        <dc:Bounds x="16" y="16" width="928" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P-SVC_di" bpmnElement="P-SVC" isHorizontal="true">
        <dc:Bounds x="16" y="116" width="928" height="492"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-AGENT_di" bpmnElement="L-AGENT" isHorizontal="true">
        <dc:Bounds x="46" y="116" width="898" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L-SYS_di" bpmnElement="L-SYS" isHorizontal="true">
        <dc:Bounds x="46" y="396" width="898" height="212"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-START_di" bpmnElement="E-START">
        <dc:Bounds x="92" y="436" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-REG_di" bpmnElement="T-REG">
        <dc:Bounds x="180" y="420" width="112" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G-TRIAGE_di" bpmnElement="G-TRIAGE" isMarkerVisible="true">
        <dc:Bounds x="402" y="431" width="42" height="42"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-REQ_di" bpmnElement="T-REQ">
        <dc:Bounds x="554" y="140" width="112" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-ASSESS_di" bpmnElement="T-ASSESS">
        <dc:Bounds x="554" y="280" width="112" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-HOLD_di" bpmnElement="E-HOLD">
        <dc:Bounds x="762" y="156" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-ESC_di" bpmnElement="T-ESC">
        <dc:Bounds x="722" y="280" width="112" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T-NOTIFY_di" bpmnElement="T-NOTIFY">
        <dc:Bounds x="722" y="420" width="112" height="64"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-ESC_di" bpmnElement="E-ESC">
        <dc:Bounds x="890" y="296" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E-END_di" bpmnElement="E-END">
        <dc:Bounds x="890" y="436" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="D-CASE_di" bpmnElement="D-CASE">
        <dc:Bounds x="221" y="539" width="30" height="38"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A-TRIAGE_di" bpmnElement="A-TRIAGE">
        <dc:Bounds x="348" y="542" width="150" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B-SLA_di" bpmnElement="B-SLA">
        <dc:Bounds x="572" y="328" width="32" height="32"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="R-E-START-sequenceFlow-T-REG_di" bpmnElement="R-E-START-sequenceFlow-T-REG">
        <di:waypoint x="124" y="452"/>
        <di:waypoint x="178" y="452"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-REG-sequenceFlow-G-TRIAGE_di" bpmnElement="R-T-REG-sequenceFlow-G-TRIAGE">
        <di:waypoint x="292" y="452"/>
        <di:waypoint x="400" y="452"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-G-TRIAGE-sequenceFlow-T-ASSESS-yes_di" bpmnElement="R-G-TRIAGE-sequenceFlow-T-ASSESS-yes">
        <di:waypoint x="444" y="452"/>
        <di:waypoint x="546" y="452"/>
        <di:waypoint x="546" y="312"/>
        <di:waypoint x="552" y="312"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-G-TRIAGE-sequenceFlow-T-REQ-no_di" bpmnElement="R-G-TRIAGE-sequenceFlow-T-REQ-no">
        <di:waypoint x="423" y="431"/>
        <di:waypoint x="423" y="172"/>
        <di:waypoint x="552" y="172"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-REQ-sequenceFlow-E-HOLD_di" bpmnElement="R-T-REQ-sequenceFlow-E-HOLD">
        <di:waypoint x="666" y="172"/>
        <di:waypoint x="760" y="172"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-ASSESS-sequenceFlow-T-NOTIFY_di" bpmnElement="R-T-ASSESS-sequenceFlow-T-NOTIFY">
        <di:waypoint x="632" y="344"/>
        <di:waypoint x="632" y="452"/>
        <di:waypoint x="720" y="452"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-B-SLA-sequenceFlow-T-ESC_di" bpmnElement="R-B-SLA-sequenceFlow-T-ESC">
        <di:waypoint x="588" y="360"/>
        <di:waypoint x="588" y="368"/>
        <di:waypoint x="756" y="368"/>
        <di:waypoint x="756" y="346"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-ESC-sequenceFlow-E-ESC_di" bpmnElement="R-T-ESC-sequenceFlow-E-ESC">
        <di:waypoint x="834" y="312"/>
        <di:waypoint x="888" y="312"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-NOTIFY-sequenceFlow-E-END_di" bpmnElement="R-T-NOTIFY-sequenceFlow-E-END">
        <di:waypoint x="834" y="452"/>
        <di:waypoint x="888" y="452"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-P-CUST-messageFlow-E-START-lodgement_di" bpmnElement="R-P-CUST-messageFlow-E-START-lodgement">
        <di:waypoint x="108" y="76"/>
        <di:waypoint x="108" y="434"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-REQ-messageFlow-P-CUST-information_request_di" bpmnElement="R-T-REQ-messageFlow-P-CUST-information_request">
        <di:waypoint x="610" y="140"/>
        <di:waypoint x="610" y="78"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-NOTIFY-messageFlow-P-CUST-outcome_di" bpmnElement="R-T-NOTIFY-messageFlow-P-CUST-outcome">
        <di:waypoint x="756" y="420"/>
        <di:waypoint x="756" y="412"/>
        <di:waypoint x="712" y="412"/>
        <di:waypoint x="712" y="78"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-T-REG-dataOutput-D-CASE_di" bpmnElement="R-T-REG-dataOutput-D-CASE">
        <di:waypoint x="236" y="484"/>
        <di:waypoint x="236" y="537"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="R-A-TRIAGE-association-G-TRIAGE_di" bpmnElement="R-A-TRIAGE-association-G-TRIAGE">
        <di:waypoint x="423" y="542"/>
        <di:waypoint x="423" y="473"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
