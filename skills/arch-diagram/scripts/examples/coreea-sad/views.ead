# Community Grants Portal: the CoreEA views of a solution architecture
# document, written in the view language. The model is declared here too:
# 131 objects and 189 relationships.
#   python3 ../../ea.py render views.ead      # writes out/*.svg|html|png|objects.json
#
# With a model this dense, every view lists the lines it is about
# (edges explicit), or the default draws every relationship between the
# boxes. Box notation labels each line with its verb.

metamodel coreea
name "Community Grants Portal"
scale 2

# ------------------------------------------------------------------ motivation
DRV-01: Driver "Applications arrive on paper and email" status=Built
DRV-02: Driver "Assessors rekey every application"
DRV-03: Driver "Applicants can't see where their application is"
DRV-04: Driver "Audit found grants paid without evidence"
GOL-01: Goal "Every application is lodged online"
GOL-02: Goal "Assessment takes days, not weeks"
GOL-03: Goal "Every payment traces to its evidence"
OBJ-01: Objective "90% of applications lodged online in year one"
OBJ-02: Objective "Applicants track status without calling"
OBJ-03: Objective "Median assessment in 10 business days"
OBJ-04: Objective "No rekeying between lodgement and assessment"
OBJ-05: Objective "Payment released only against an approved acquittal"
OBJ-06: Objective "Every decision has its evidence attached"
REQ-01: Requirement "Applicants lodge and save drafts online"
REQ-02: Requirement "Applicants sign in with their existing identity"
REQ-03: Requirement "Status shown to the applicant at every step"
REQ-04: Requirement "Assessors score against the published criteria"
REQ-05: Requirement "Conflicts of interest declared before scoring"
REQ-06: Requirement "Panel decision recorded with reasons"
REQ-07: Requirement "Payments created in the finance system, not rekeyed"
REQ-08: Requirement "Acquittal evidence uploaded and checked"
REQ-09: Requirement "Documents scanned for malware on upload"
REQ-10: Requirement "Records kept for seven years"
REQ-11: Requirement "Accessible to WCAG 2.2 AA"
REQ-12: Requirement "Available 99.5% in business hours"
REQ-13: Requirement "Personal information stays in Australia"
REQ-14: Requirement "Every action audited"
PRN-01: Principle "Reuse the council's identity service"
PRN-02: Principle "Buy commodity, build what's ours"
PRN-03: Principle "One record per grant"
PRN-04: Principle "Data stays onshore"

# ------------------------------------------------------------------ business
CAP-00: Capability "Grants management"
CAP-01: Capability "Grant program design" parent=CAP-00
CAP-02: Capability "Application intake" parent=CAP-00
CAP-03: Capability "Assessment and decision" parent=CAP-00
CAP-04: Capability "Grant payment" parent=CAP-00
CAP-05: Capability "Acquittal" parent=CAP-00
CAP-10: Capability "Council shared services"
CAP-11: Capability "Identity and access" parent=CAP-10 serves=CAP-02
CAP-12: Capability "Records management" parent=CAP-10 serves=CAP-05
CAP-13: Capability "Accounts payable" parent=CAP-10 serves=CAP-04
PRC-01: Process "Publish a funding round"
PRC-02: Process "Lodge an application"
PRC-03: Process "Check eligibility"
PRC-04: Process "Score and moderate"
PRC-05: Process "Decide and notify"
PRC-06: Process "Pay and acquit"
ORG-01: Organization "Community Development"
ORG-02: Organization "Finance"
ORG-03: Organization "Digital Services"
ORG-04: Organization "Records and Information"
ACT-01: Actor "Applicant (community group)"
ACT-02: Actor "Grants officer"
ACT-03: Actor "Assessment panel member"
ACT-04: Actor "Finance officer"
ACT-05: Actor "Service desk analyst"
ROL-01: Role "Program owner"
ROL-02: Role "Assessor"
ROL-03: Role "Payments approver"
ROL-04: Role "Platform owner"

# ------------------------------------------------------------------ application
APP-01: Application "Grants Portal" status=Designed owner=ORG-03
APP-02: Application "Applicant site" parent=APP-01 status=Designed
APP-03: Application "Staff workspace" parent=APP-01 status=Designed
APP-04: Application "Grants API" parent=APP-01 status=Designed
APP-05: Application "Workflow engine" parent=APP-01 status=Designed
APP-06: Application "Document service" parent=APP-01 status=Designed
APP-07: Application "Notification worker" parent=APP-01 status=Designed
APP-ID: Application "Council identity service — defined in the Identity SAD" status=Built
APP-FIN: Application "Finance system" status=Built
APP-EDRMS: Application "Records system (EDRMS)" status=Built
APP-CRM: Application "Customer request system" status=Built
APP-MAIL: Application "Email and SMS gateway" status=Built
APP-SCAN: Application "Malware scanning service" status=Built
APC-01: Application Category "Customer-facing"
APC-02: Application Category "Corporate systems"
APC-03: Application Category "Shared platform services"
INT-01: Interface "Sign-in (OIDC)" status=Built
INT-02: Interface "Grants REST API" status=Designed
INT-03: Interface "Supplier and payment import" status=Built
INT-04: Interface "Record capture" status=Built
INT-05: Interface "Case lookup" status=Built
INT-06: Interface "Send message" status=Built
INT-07: Interface "Scan file" status=Built
INT-08: Interface "Payment status feed" status=Built

# ------------------------------------------------------------------ data
DTC-01: Data Category "Application record" classification="OFFICIAL: Sensitive"
DTC-02: Data Category "Assessment" classification="OFFICIAL: Sensitive"
DTC-03: Data Category "Financial" classification="OFFICIAL: Sensitive"
DTC-04: Data Category "Reference data" classification=OFFICIAL
DTC-05: Data Category "Operational" classification=OFFICIAL
DAT-01: Data Entity "Applicant organisation" systemOfRecord="Grants Portal"
DAT-02: Data Entity "Application" systemOfRecord="Grants Portal"
DAT-03: Data Entity "Supporting document" systemOfRecord="Records system"
DAT-04: Data Entity "Eligibility check" systemOfRecord="Grants Portal"
DAT-05: Data Entity "Score and comment" systemOfRecord="Grants Portal"
DAT-06: Data Entity "Conflict declaration" systemOfRecord="Grants Portal"
DAT-07: Data Entity "Panel decision" systemOfRecord="Records system"
DAT-08: Data Entity "Funding agreement" systemOfRecord="Records system"
DAT-09: Data Entity "Payment" systemOfRecord="Finance system"
DAT-10: Data Entity "Acquittal" systemOfRecord="Grants Portal"
DAT-11: Data Entity "Funding round" systemOfRecord="Grants Portal"
DAT-12: Data Entity "Assessment criterion" systemOfRecord="Grants Portal"
DAT-13: Data Entity "Audit event" systemOfRecord="Log workspace"
DAT-14: Data Entity "Notification" systemOfRecord="not kept"

# ------------------------------------------------------------------ technology
LOC-01: Location "Azure Australia East"
LOC-02: Location "Azure Australia Southeast"
LOC-03: Location "Council data centre"
TCC-01: Technology Category "Compute"
TCC-02: Technology Category "Data"
TCC-03: Technology Category "Operations"
TEC-01: Technology "Container Apps environment" status=Designed
TEC-02: Technology "PostgreSQL flexible server" status=Designed
TEC-03: Technology "Blob storage" status=Designed
TEC-04: Technology "Service Bus" status=Designed
TEC-05: Technology "Key Vault" status=Designed
TEC-06: Technology "Application Gateway and WAF" status=Designed
TEC-07: Technology "Log Analytics" status=Built
TEC-08: Technology "Backup vault" status=Designed
TEC-09: Technology "Council data centre network" status=Built

# ------------------------------------------------------------------ risk and control
RSK-01: Risk "Malicious file uploaded with an application"
RSK-02: Risk "Applicant data exposed through the public site"
RSK-03: Risk "Payment made twice or to the wrong account"
RSK-04: Risk "Decision challenged without a record of reasons"
RSK-05: Risk "Platform unavailable at a round's closing date"
RSK-06: Risk "Assessor scores an application they're conflicted on"
CTL-01: Control "Every upload scanned before it's stored" status=Designed
CTL-02: Control "WAF and private endpoints in front of the platform" status=Designed
CTL-03: Control "Payments created only from the approved agreement" status=Designed
CTL-04: Control "Decision and reasons captured to the records system" status=Designed
CTL-05: Control "Zone-redundant runtime and tested restore" status=Designed
CTL-06: Control "Conflict declared before the scoring form opens" status=Designed
PRJ-01: Project "Grants Portal delivery" status=Designed

