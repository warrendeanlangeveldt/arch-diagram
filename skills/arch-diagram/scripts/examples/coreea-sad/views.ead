# ------------------------------------------------------------------ views

view ACD "V1 Application Context" {
  viewpoint "Application Context Diagram"
  platform azure
  edges explicit                  # the model joins these boxes 60-odd ways; draw the context
  join both                       # lines of one verb into or out of one box share a trunk
  ACT-01
  ACT-02
  ACT-03
  same ACT-01 ACT-02 ACT-03
  APP-01 {
    APP-02
    APP-03
    APP-04
    APP-05
    APP-06
    APP-07
  }
  INT-02 on APP-04
  APP-ID {
    INT-01
  }
  APP-FIN {
    INT-03
    INT-08
  }
  APP-EDRMS {
    INT-04
  }
  APP-CRM {
    INT-05
  }
  APP-MAIL {
    INT-06
  }
  APP-SCAN {
    INT-07
  }
  APP-01 before APP-ID APP-FIN APP-EDRMS APP-CRM APP-MAIL APP-SCAN
  same APP-ID APP-FIN APP-EDRMS
  same APP-CRM APP-MAIL APP-SCAN
  TEC-01 icon="Container Apps"
  LOC-01
  ACT-01 -[uses]-> APP-02
  ACT-02 -[uses]-> APP-03
  ACT-03 -[uses]-> APP-03
  APP-01 -[depends on]-> APP-ID
  APP-05 -[depends on]-> APP-FIN
  APP-06 -[depends on]-> APP-EDRMS
  APP-03 -[depends on]-> APP-CRM
  APP-07 -[depends on]-> APP-MAIL
  APP-06 -[depends on]-> APP-SCAN
  APP-01 -[hosted on]-> TEC-01
  TEC-01 -[located in]-> LOC-01
  key "Box inside a box: part of it (parent)" "Pill on an application: interface it exposes" "Pills inside a box: interfaces it exposes"
}

view LDD "V2 Logical Data" {
  viewpoint "Logical Data Diagram"
  edges explicit                  # categories flow into columns when no lines join them
  DTC-01 sub="OFFICIAL: Sensitive" {
    DAT-01
    DAT-02
    DAT-03
  }
  DTC-02 sub="OFFICIAL: Sensitive" {
    DAT-04
    DAT-05
    DAT-06
    DAT-07
  }
  DTC-03 sub="OFFICIAL: Sensitive" {
    DAT-08
    DAT-09
    DAT-10
  }
  DTC-04 sub=OFFICIAL {
    DAT-11
    DAT-12
  }
  DTC-05 sub=OFFICIAL {
    DAT-13
    DAT-14
  }
  key "Entity inside a data category: classified as; the category's sub-line gives its classification"
}

view STRAT "V3 Business Outcome Alignment" {
  viewpoint "Business Strategy Diagram"   # this viewpoint reads left to right
  edges explicit
  join both                               # lines of one verb share a trunk and one label
  DRV-01
  DRV-02
  DRV-03
  DRV-04
  GOL-01
  GOL-02
  GOL-03
  OBJ-01
  OBJ-02
  OBJ-03
  OBJ-04
  OBJ-05
  OBJ-06
  CAP-02
  CAP-03
  CAP-04
  CAP-05
  DRV-01 -[motivates]-> GOL-01
  DRV-02 -[motivates]-> GOL-02
  DRV-03 -[motivates]-> GOL-01
  DRV-04 -[motivates]-> GOL-03
  DRV-02 -[motivates]-> GOL-03
  GOL-01 -[achieved by]-> OBJ-01
  GOL-01 -[achieved by]-> OBJ-02
  GOL-02 -[achieved by]-> OBJ-03
  GOL-02 -[achieved by]-> OBJ-04
  GOL-03 -[achieved by]-> OBJ-05
  GOL-03 -[achieved by]-> OBJ-06
  CAP-02 -[supports]-> OBJ-01
  CAP-02 -[supports]-> OBJ-02
  CAP-03 -[supports]-> OBJ-03
  CAP-03 -[supports]-> OBJ-04
  CAP-04 -[supports]-> OBJ-05
  CAP-05 -[supports]-> OBJ-06
  OBJ-01 before CAP-02 CAP-03 CAP-04 CAP-05
  key "Joined lines: one relationship per source or target"
}

view CAP "V4 Capability Alignment" {
  viewpoint "Capability Diagram"
  edges explicit
  same by=serves                  # each shared service beside the grants capability it serves (a field)
  CAP-00 {
    CAP-01
    CAP-02
    CAP-03
    CAP-04
    CAP-05
  }
  CAP-10 {
    CAP-11
    CAP-12
    CAP-13
  }
  key "Box inside a box: part of it (parent)" "Same row: the shared service a grants capability relies on (its 'serves' field)"
}

view RISK "V5 Control Traceability" {
  viewpoint "Risk Catalogue"            # three columns: risks, controls, what they realise and apply to
  edges explicit
  join in
  RSK-01
  RSK-02
  RSK-03
  RSK-04
  RSK-05
  RSK-06
  CTL-01
  CTL-02
  CTL-03
  CTL-04
  CTL-05
  CTL-06
  REQ-05
  REQ-06
  REQ-07
  REQ-09
  REQ-12
  REQ-13
  CTL-01 -[mitigates]-> RSK-01
  CTL-02 -[mitigates]-> RSK-02
  CTL-03 -[mitigates]-> RSK-03
  CTL-04 -[mitigates]-> RSK-04
  CTL-05 -[mitigates]-> RSK-05
  CTL-06 -[mitigates]-> RSK-06
  CTL-01 -[realises]-> REQ-09
  CTL-02 -[realises]-> REQ-13
  CTL-03 -[realises]-> REQ-07
  CTL-04 -[realises]-> REQ-06
  CTL-05 -[realises]-> REQ-12
  CTL-06 -[realises]-> REQ-05
  key "Read left to right: the risk, the control that mitigates it, the requirement the control realises"
}

view INFRA "V6 Infrastructure" {
  viewpoint "Infrastructure Diagram"
  platform azure
  edges explicit
  LOC-01 {
    TCC-01 {
      TEC-06
      TEC-01
    }
    TCC-02 {
      TEC-02
      TEC-03
      TEC-04
    }
    TCC-03 {
      TEC-05
      TEC-07
      TEC-08#primary
    }
  }
  LOC-02 {
    TEC-08#copy sub="geo-redundant copy"
  }
  TCC-01 before TCC-02             # the categories one under another, in this order
  TCC-02 before TCC-03
  TEC-06 -[depends on]-> TEC-01
  TEC-01 -[depends on]-> TEC-02
  TEC-01 -[depends on]-> TEC-04
  TEC-02 -[depends on]-> TEC-08
  key "Box inside a box: in that location, then in that technology category" "The backup vault is drawn in both regions it spans"
}
