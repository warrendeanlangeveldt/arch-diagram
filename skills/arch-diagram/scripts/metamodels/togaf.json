  "orchestrates": {"pairs": [[["Process"], ["Function"]]]},
  "realizes": {"pairs": [[["Process"], ["Business Service"]], [["Information System Service"], ["Business Service"]], [["Physical Application Component"], ["Logical Application Component"]], [["Physical Technology Component"], ["Logical Technology Component", "Physical Application Component"]], [["Physical Data Component"], ["Logical Data Component"]], [["Work Package"], ["Requirement"]], [["Function", "Process"], ["Business Capability"]]]},
  "provides governed interface to access": {"pairs": [[["Business Service"], ["Function"]]]},
  "is guided by": {"pairs": [[["Process"], ["Control"]]]},
