  "Functional Decomposition diagram": {"kind": "diagram", "phase": "B", "purpose": "Business functions decomposed by parent.", "types": ["Function", "Organization Unit", "Business Capability"]},
  "Process Flow diagram": {"kind": "diagram", "phase": "B", "purpose": "Sequence of processes with the events, controls and products they involve.", "types": ["Process", "Event", "Control", "Product", "Actor", "Role", "Function"]},
  "Event diagram": {"kind": "diagram", "phase": "B", "purpose": "Events that trigger processes and the actors that generate them.", "types": ["Event", "Process", "Actor"]},
  "Conceptual Data diagram": {"kind": "diagram", "phase": "C", "purpose": "Key data entities and how they relate.", "types": ["Data Entity"]},
  "Logical Data diagram": {"kind": "diagram", "phase": "C", "purpose": "Data entities grouped into logical data components with their associations.", "types": ["Data Entity", "Logical Data Component"]},
  "Data Dissemination diagram": {"kind": "diagram", "phase": "C", "purpose": "Data entities, the business services that use them and the application components that hold them.", "types": ["Data Entity", "Business Service", "Logical Application Component", "Physical Application Component", "Physical Data Component"]},
  "Data Security diagram": {"kind": "diagram", "phase": "C", "purpose": "Which actors and roles may access which data, through which components.", "types": ["Actor", "Role", "Data Entity", "Logical Application Component", "Location"]},
  "Application Communication diagram": {"kind": "diagram", "phase": "C", "purpose": "Application components and the communication between them.", "types": ["Logical Application Component", "Physical Application Component", "Information System Service", "Data Entity"]},
  "Application and User Location diagram": {"kind": "diagram", "phase": "C", "purpose": "Where applications are used and by whom.", "types": ["Location", "Actor", "Role", "Organization Unit", "Physical Application Component"]},
  "Application Use-Case diagram": {"kind": "diagram", "phase": "C", "purpose": "Actors and roles and the application services they use.", "types": ["Actor", "Role", "Information System Service", "Logical Application Component"]},
  "Processes/Application Realization diagram": {"kind": "diagram", "phase": "C", "purpose": "How processes are supported by applications.", "types": ["Process", "Event", "Logical Application Component", "Physical Application Component", "Information System Service"]},
  "Environments and Locations diagram": {"kind": "diagram", "phase": "D", "purpose": "Which locations host which technology and applications.", "types": ["Location", "Physical Technology Component", "Physical Application Component", "Physical Data Component"]},
  "Platform Decomposition diagram": {"kind": "diagram", "phase": "D", "purpose": "Technology platforms decomposed into components and the services they provide.", "types": ["Technology Service", "Logical Technology Component", "Physical Technology Component"]},
  "Network Computing/Hardware diagram": {"kind": "diagram", "phase": "D", "purpose": "Physical technology components and where they are deployed.", "types": ["Physical Technology Component", "Physical Application Component", "Location"]},
  "Project Context diagram": {"kind": "diagram", "phase": "E", "purpose": "The scope of a work package: what it delivers and the requirements and gaps it addresses.", "types": ["Work Package", "Requirement", "Gap", "Business Capability", "Logical Application Component", "Physical Application Component", "Logical Technology Component", "Physical Technology Component", "Organization Unit", "Business Service"]},
  "Benefits diagram": {"kind": "diagram", "phase": "E", "purpose": "Opportunities and the goals and objectives they meet.", "types": ["Work Package", "Goal", "Objective", "Measure", "Business Capability"]},
  "Requirements catalog": {"kind": "catalog", "phase": "Requirements Management", "purpose": "Every requirement, constraint and assumption.", "types": ["Requirement", "Constraint", "Assumption"]},
  "Principles catalog": {"kind": "catalog", "phase": "Preliminary", "purpose": "Every architecture principle.", "types": ["Principle"]},
  "Organization/Actor catalog": {"kind": "catalog", "phase": "B", "purpose": "Every organization unit and actor.", "types": ["Organization Unit", "Actor", "Location"]},
  "Application Portfolio catalog": {"kind": "catalog", "phase": "C", "purpose": "Every application component.", "types": ["Logical Application Component", "Physical Application Component", "Information System Service"]},
  "Technology Portfolio catalog": {"kind": "catalog", "phase": "D", "purpose": "Every technology component.", "types": ["Technology Service", "Logical Technology Component", "Physical Technology Component"]},
  "Stakeholder Map matrix": {"kind": "matrix", "phase": "A", "purpose": "Stakeholders against their concerns.", "types": ["Actor", "Role", "Organization Unit"]},
  "Actor/Role matrix": {"kind": "matrix", "phase": "B", "purpose": "Which actors perform which roles.", "types": ["Actor", "Role"], "rows": "Actor", "columns": "Role", "verb": "performs task in"},
  "Data Entity/Business Function matrix": {"kind": "matrix", "phase": "C", "purpose": "Which business services consume or provide which data entities.", "types": ["Data Entity", "Business Service"], "rows": "Data Entity", "columns": "Business Service"},
  "Application/Data matrix": {"kind": "matrix", "phase": "C", "purpose": "Which application components operate on which data entities (CRUD).", "types": ["Data Entity", "Logical Application Component", "Physical Application Component"], "rows": "Data Entity", "columns": "Physical Application Component", "verb": "operates on"},
  "Application/Organization matrix": {"kind": "matrix", "phase": "C", "purpose": "Which organization units own which applications.", "types": ["Organization Unit", "Physical Application Component", "Logical Application Component"], "rows": "Physical Application Component", "columns": "Organization Unit", "verb": "owns"},
  "Application/Technology matrix": {"kind": "matrix", "phase": "D", "purpose": "Which applications are hosted on which technology.", "types": ["Physical Application Component", "Physical Technology Component"], "rows": "Physical Application Component", "columns": "Physical Technology Component", "verb": "is hosted on"}
