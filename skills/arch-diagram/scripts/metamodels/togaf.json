  "meets": {"pairs": [[["Business Service", "Information System Service", "Technology Service"], ["Service Quality"]]]},
  "enables": {"pairs": [[["Business Capability"], ["Value Stream"]]]},
  "influences": {"pairs": [[["Course of Action"], ["Business Capability", "Value Stream"]]]},
  "is delivered by": {"pairs": [[["Business Capability"], ["Work Package"]]]},
  "resides within": {"pairs": [[["Data Entity"], ["Logical Data Component"]]]},
  "relates to": {"pairs": [[["Data Entity"], ["Data Entity"]]]},
  "implements": {"pairs": [[["Logical Application Component"], ["Information System Service"]]]},
