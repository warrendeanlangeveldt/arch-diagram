  "encapsulates": {"pairs": [[["Physical Application Component"], ["Physical Data Component"]]]},
  "communicates with": {"pairs": [[["Logical Application Component"], ["Logical Application Component"]], [["Physical Application Component"], ["Physical Application Component"]]]},
  "is hosted on": {"pairs": [[["Physical Application Component", "Physical Data Component"], ["Physical Technology Component"]]]},
  "is located at": {"pairs": [[["Physical Technology Component", "Physical Application Component"], ["Location"]]]},
  "delivers": {"pairs": [[["Work Package"], ["Business Capability", "Logical Application Component", "Physical Application Component", "Logical Technology Component", "Physical Technology Component", "Business Service"]]]},
  "closes": {"pairs": [[["Work Package"], ["Gap"]]]},
  "addresses": {"pairs": [[["Requirement"], ["Business Service", "Information System Service", "Technology Service", "Logical Application Component", "Logical Technology Component", "Function", "Process"]]]}
 },
 "viewpoints": {
  "Business Footprint diagram": {"kind": "diagram", "phase": "B", "purpose": "Goals and organization units linked to business functions, services and the technical components that deliver them.", "types": ["Goal", "Objective", "Organization Unit", "Function", "Business Service", "Information System Service", "Logical Application Component", "Logical Technology Component", "Physical Application Component", "Physical Technology Component"]},
  "Value Chain diagram": {"kind": "diagram", "phase": "A", "purpose": "High-level orientation: the value the enterprise creates and the capabilities that create it.", "types": ["Value Stream", "Business Capability", "Organization Unit", "Product", "Actor"]},
  "Solution Concept diagram": {"kind": "diagram", "phase": "A", "purpose": "High-level orientation of the solution envisaged to meet the objectives.", "types": ["Driver", "Goal", "Objective", "Actor", "Role", "Organization Unit", "Business Service", "Logical Application Component", "Information System Service", "Logical Technology Component", "Location"]},
  "Business Capability Map": {"kind": "diagram", "phase": "B", "purpose": "The capabilities of the enterprise, decomposed, with the organization units that own them.", "types": ["Business Capability", "Organization Unit", "Value Stream", "Course of Action"]},
