  "performed at": {"essential": "Physical_Process.process_performed_at_sites", "pairs": [[["Physical Process"], ["Site"]]]},
  "member of": {"layout": "up", "essential": "Individual_Actor.is_member_of_actor / Group_Actor.contained_sub_actors", "pairs": [[["Individual Actor", "Group Actor"], ["Group Actor"]]]},
