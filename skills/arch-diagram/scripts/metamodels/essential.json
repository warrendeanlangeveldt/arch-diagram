  "uses information": {"essential": "APP_PRO_TO_INFOREP_RELATION (app_pro_to_inforep_from_app -> app_pro_to_inforep_to_inforep); put C/R/U/D in crud", "pairs": [[["Application Provider", "Composite Application Provider"], ["Information Representation"]]]},
  "sends information to": {"essential": "Static_Application_Provider_Usage / :APU-TO-APU-STATIC-RELATION (apu_to_apu_relation_inforeps)", "pairs": [[["Application Provider", "Composite Application Provider"], ["Application Provider", "Composite Application Provider"]]]},
  "deploys": {"layout": "up", "essential": "Application_Deployment.application_provider_deployed", "pairs": [[["Application Deployment"], ["Application Provider", "Composite Application Provider"]]]},
  "deployed on": {"layout": "down", "essential": "Application_Deployment.application_deployment_technical_arch / technology_instance_deployed_on_node", "pairs": [[["Application Deployment"], ["Technology Node"]]]},
  "runs on": {"layout": "down", "essential": "Application_Provider.technology_provider_architecture (Technology_Product_Build)", "pairs": [[["Application Provider", "Composite Application Provider"], ["Technology Product"]]]},
  "located at": {"essential": "Technology_Node.technology_deployment_located_at", "pairs": [[["Technology Node"], ["Site"]]]},
  "hosts": {"layout": "down", "essential": "Technology_Node.technology_instance_deployed_on_node (Technology_Product instance)", "pairs": [[["Technology Node"], ["Technology Product"]]]},
  "supplied by": {"essential": "Technology_Product.supplier_technology_product / Application_Provider.ap_supplier", "pairs": [[["Technology Product", "Application Provider"], ["Supplier"]]]},
  "represents": {"layout": "up", "essential": "Information_Representation.implemented_information_views", "pairs": [[["Information Representation"], ["Information View"]]]},
  "refines": {"layout": "up", "essential": "Information_View.refinement_of_information_concept", "pairs": [[["Information View"], ["Information Concept"]]]},
  "defined by": {"layout": "up", "essential": "Data_Object.defined_by_data_subject", "pairs": [[["Data Object"], ["Data Subject"]]]},
  "persists": {"layout": "down", "essential": "Information_Representation.app_pro_persists_info_rep / Data_Representation", "pairs": [[["Information Representation"], ["Data Representation"]]]},
  "plans change to": {"essential": "PLAN_TO_ELEMENT_RELATION (plan_to_element_plan -> plan_to_element_ea_element); put the Planning_Action in note", "pairs": [[["Strategic Plan"], ["Business Capability", "Business Process", "Physical Process", "Application Provider", "Composite Application Provider", "Application Service", "Technology Product", "Technology Node", "Information Representation", "Group Actor"]]]},
  "supports objective": {"layout": "up", "essential": "Enterprise_Strategic_Plan.strategic_plan_supports_objective", "pairs": [[["Strategic Plan"], ["Business Objective"]]]},
